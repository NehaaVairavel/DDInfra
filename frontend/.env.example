# DDInfra and Co — Frontend Environment

# The URL of your Flask backend API
# Development: http://localhost:5000/api
# Production: https://your-ddinfra-backend-domain.com/api
VITE_API_URL=http://localhost:5000/api

# Optional: Cloudflare R2 Public URL (used for hero media slider)
# This is read by the frontend to resolve R2 media URLs in the hero slider.
# If not set, the backend's serialized URLs are used instead.
# Format: https://pub-XXXXXXXX.r2.dev  (your DDInfra R2 bucket public URL)
VITE_R2_PUBLIC_URL=<YOUR_DDINFRA_R2_PUBLIC_URL>
